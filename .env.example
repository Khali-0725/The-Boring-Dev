# Environment variables for The Boring Dev
# Multi-provider failover — add as many keys as you have.
# The server tries them top to bottom; if one is rate-limited, it uses the next.
# Add these in Vercel -> Settings -> Environment Variables.
#
# You need AT LEAST ONE. Add more free ones to effectively never run out per day.

# 1) Groq — https://console.groq.com/keys   (free, very fast)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2) OpenRouter — https://openrouter.ai/keys  (free ":free" models like DeepSeek/Qwen)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3:free

# 3) NVIDIA NIM — https://build.nvidia.com  (100+ free models: Llama, DeepSeek, Qwen)
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 4) Mistral — https://console.mistral.ai  (free tier)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# 5) SambaNova — https://cloud.sambanova.ai  (free, very fast, OpenAI-compatible)
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
